views:
  - type: cards
    name: Card
    filters:
      and:
        - file.hasTag("Resources")
    order:
      - file.name
      - link
    cardSize: 170
    image: note.image
    imageAspectRatio: 0.65
  - type: cards
    name: Desktop-card-view
    filters:
      and:
        - file.hasTag("Resources")
    order:
      - file.name
      - link
    cardSize: 360
    image: note.image
    imageAspectRatio: 0.65
  - type: cards
    name: View
